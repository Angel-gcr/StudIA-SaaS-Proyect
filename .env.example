# =============================================================================
# StudIA — Variables de entorno
# =============================================================================
# Copia este archivo como ".env.local" y rellena los valores reales.
# ".env.local" NUNCA se sube a git (ya está en .gitignore).
#
# IMPORTANTE — pública vs secreta:
#   - Las variables con prefijo NEXT_PUBLIC_ SÍ llegan al navegador del
#     usuario. Solo deben ir aquí claves diseñadas para ser públicas
#     (la anon key de Supabase está diseñada para esto: es pública a
#     propósito, y la seguridad real la da el RLS, no el secreto de la clave).
#   - Las variables SIN ese prefijo solo existen en el servidor (Route
#     Handlers, Server Actions, middleware) y nunca se envían al cliente.
#     Aquí van la service_role de Supabase y las claves de IA/Stripe.
# =============================================================================

# --- Supabase (Fase 1) ---------------------------------------------------
# Pública: URL del proyecto Supabase. Se puede exponer sin problema.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Pública: anon key. Respeta RLS siempre; es segura de exponer en el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETA: salta el RLS por completo. Solo en el servidor. NUNCA en el cliente,
# nunca en el repo, nunca en una variable NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA multi-proveedor (Fase 3, aún no se usa en Fase 1) -----------------
# SECRETA. Se llama siempre desde un proxy de servidor.
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1/

# SECRETA. Se llama siempre desde un proxy de servidor.
GEMINI_API_KEY=

# --- Stripe (Fase 6+, maqueta primero) ------------------------------------
# SECRETA. No se usa en Fase 1.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
